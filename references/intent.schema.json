{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-figure-studio.local/intent.schema.json",
  "title": "Semantically parsed figure intent",
  "description": "LLM/user parses meaning first; route.py validates and dispatches. It is not an NLP classifier.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1
    },
    "request": {
      "type": "string",
      "description": "Original user wording retained for semantic review; never evaluated as commands."
    },
    "purpose": {
      "enum": [
        "explain_system",
        "compare_cases",
        "show_execution",
        "present_text",
        "organize_categories",
        "show_composition",
        "compare_values",
        "show_change",
        "show_pairwise_values",
        "show_relationship",
        "show_distribution",
        "compare_profiles",
        "unknown"
      ],
      "default": "unknown"
    },
    "relationship": {
      "enum": [
        "directed_flow",
        "qualitative_contrast",
        "event_sequence",
        "verbatim",
        "hierarchy",
        "category_mapping",
        "part_to_whole",
        "category_magnitude",
        "ordered_numeric",
        "matrix",
        "coordinate",
        "sample_distribution",
        "profile",
        "unknown"
      ],
      "default": "unknown"
    },
    "evidence": {
      "enum": [
        "nodes_edges",
        "text_cases",
        "step_records",
        "screenshots",
        "text_code",
        "category_tree",
        "category_mapping",
        "counts",
        "category_values",
        "ordered_values",
        "matrix",
        "point_coordinates",
        "raw_samples",
        "metric_profiles",
        "unknown"
      ],
      "default": "unknown"
    },
    "explicit_type": {
      "enum": [
        "architecture",
        "comparison",
        "trajectory",
        "text_card",
        "taxonomy",
        "proportion",
        "bar",
        "line",
        "matrix",
        "scatter",
        "distribution",
        "radar",
        "multipanel",
        null
      ],
      "description": "Only a type explicitly requested by the user, not an inferred preference."
    },
    "excluded_types": {
      "type": "array",
      "items": {
        "enum": [
          "architecture",
          "comparison",
          "trajectory",
          "text_card",
          "taxonomy",
          "proportion",
          "bar",
          "line",
          "matrix",
          "scatter",
          "distribution",
          "radar",
          "multipanel"
        ]
      },
      "uniqueItems": true
    },
    "data_status": {
      "enum": [
        "ready",
        "partial",
        "missing"
      ],
      "default": "missing",
      "description": "Availability of actual drawing inputs; missing data must not change the semantic route."
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "semantic_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Short grounded statements such as independent marginal categories or actual run evidence."
    },
    "language": {
      "enum": [
        "zh",
        "en"
      ],
      "default": "zh"
    },
    "composition": {
      "type": "boolean",
      "default": false
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "intent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "$ref": "#/$defs/leaf"
          }
        }
      }
    }
  },
  "$defs": {
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1
        },
        "request": {
          "type": "string",
          "description": "Original user wording retained for semantic review; never evaluated as commands."
        },
        "purpose": {
          "enum": [
            "explain_system",
            "compare_cases",
            "show_execution",
            "present_text",
            "organize_categories",
            "show_composition",
            "compare_values",
            "show_change",
            "show_pairwise_values",
            "show_relationship",
            "show_distribution",
            "compare_profiles",
            "unknown"
          ],
          "default": "unknown"
        },
        "relationship": {
          "enum": [
            "directed_flow",
            "qualitative_contrast",
            "event_sequence",
            "verbatim",
            "hierarchy",
            "category_mapping",
            "part_to_whole",
            "category_magnitude",
            "ordered_numeric",
            "matrix",
            "coordinate",
            "sample_distribution",
            "profile",
            "unknown"
          ],
          "default": "unknown"
        },
        "evidence": {
          "enum": [
            "nodes_edges",
            "text_cases",
            "step_records",
            "screenshots",
            "text_code",
            "category_tree",
            "category_mapping",
            "counts",
            "category_values",
            "ordered_values",
            "matrix",
            "point_coordinates",
            "raw_samples",
            "metric_profiles",
            "unknown"
          ],
          "default": "unknown"
        },
        "explicit_type": {
          "enum": [
            "architecture",
            "comparison",
            "trajectory",
            "text_card",
            "taxonomy",
            "proportion",
            "bar",
            "line",
            "matrix",
            "scatter",
            "distribution",
            "radar",
            null
          ]
        },
        "excluded_types": {
          "type": "array",
          "items": {
            "enum": [
              "architecture",
              "comparison",
              "trajectory",
              "text_card",
              "taxonomy",
              "proportion",
              "bar",
              "line",
              "matrix",
              "scatter",
              "distribution",
              "radar",
              "multipanel"
            ]
          },
          "uniqueItems": true
        },
        "data_status": {
          "enum": [
            "ready",
            "partial",
            "missing"
          ],
          "default": "missing",
          "description": "Availability of actual drawing inputs; missing data must not change the semantic route."
        },
        "missing_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semantic_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Short grounded statements such as independent marginal categories or actual run evidence."
        },
        "language": {
          "enum": [
            "zh",
            "en"
          ],
          "default": "zh"
        }
      }
    }
  }
}
